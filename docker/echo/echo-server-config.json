{
    "domain": "nginx",
    "port": 6001,
    "secure": false,
    "verifyAuthPath": "/broadcasting/auth",
    "verifyAuth": true,
    "protocol": "http",
    "sslCertPath": "",
    "sslKeyPath": "",
    "apiOriginPort": 80,
    "allowCors": true,
    "corsOrigin": "${ECHO_CORS_ORIGIN}",
    "corsMethods": ["GET", "POST"],
    "corsHeaders": ["Content-Type", "Authorization", "X-CSRF-TOKEN", "X-Requested-With"],
    "corsCredentials": true,
    "database": "redis",
    "databaseConfig": {
        "redis": {
            "host": "${REDIS_HOST}",
            "port": "${REDIS_PORT}",
            "keyPrefix": "${REDIS_KEY_PREFIX}"
        }
    },
    "devMode": true,
    "host": "0.0.0.0",
    "authEndpoint": "/broadcasting/auth",
    "clients": [],
    "referrers": [],
    "protocols": ["http"],
    "allowGuestAccess": false,
    "authHost": "${ECHO_AUTH_HOST}",
    "publishPresence": true
}
